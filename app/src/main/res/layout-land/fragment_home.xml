<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.HomeFragment">

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <!-- Date alone at the top; the middle of the screen is left for gestures. -->
    <TextView
        android:id="@+id/date"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="40dp"
        tools:text="Sun, 13 Sep" />

    <!-- Bottom row: the search composer and the password-manager glyph, aligned to the
         composer's bottom edge so the glyph stays put while the composer grows upward. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="24dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- Search composer: text goes to the default browser's search engine. The draft
             survives leaving the screen; only a successful send or the clear button empties it. -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:alpha="0.8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/searchInput"
                style="@style/TextSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/search_the_web"
                android:gravity="center_vertical"
                android:imeOptions="flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingVertical="10dp"
                android:scrollbars="vertical"
                tools:ignore="LabelFor" />

            <ImageView
                android:id="@+id/searchClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:padding="8dp"
                android:src="@drawable/ic_clear_text"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/searchGo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_the_web"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_forward"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Password manager: same height as the composer so the row reads as one piece. -->
        <ImageView
            android:id="@+id/passwordManager"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_quick_action"
            android:clickable="true"
            android:contentDescription="@string/password_manager"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_key" />
    </LinearLayout>

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="120dp"
        android:text="@string/swipe_up_for_apps"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="120dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>
