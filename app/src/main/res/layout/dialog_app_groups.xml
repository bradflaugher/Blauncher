<?xml version="1.0" encoding="utf-8"?>
<!-- Group sheet for one app: the groups it is shown under. Group checkboxes are added in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/dialogPreferredPadding"
            android:paddingTop="4dp"
            android:text="@string/groups"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="?android:attr/textColorAlertDialogListItem" />

        <TextView
            android:id="@+id/groupsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:paddingHorizontal="?attr/dialogPreferredPadding"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="?android:attr/textColorAlertDialogListItem"
            tools:text="@string/groups_automatic_summary" />

        <LinearLayout
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
