<?xml version="1.0" encoding="utf-8"?>
<!-- "Select an app": the picker behind a gesture, the date or the key. Its search field wears the
     home screen's search-bar pill so the two read as the same control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:orientation="vertical">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/home_margin_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/search_row_margin_bottom"
        android:background="@drawable/bg_search_bar"
        android:imeOptions="actionSearch"
        android:minHeight="52dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textCursorDrawable="@null"
        app:closeIcon="@null"
        app:iconifiedByDefault="false"
        app:queryBackground="@null"
        app:queryHint="@string/select_an_app"
        app:searchHintIcon="@null"
        app:searchIcon="@drawable/ic_search"
        app:theme="@style/AppSearchText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/drawer_margin_horizontal"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical" />

</LinearLayout>
