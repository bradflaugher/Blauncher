<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.HomeFragment">

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <!-- Everything on the home screen: clock, date, search bar, quick actions. -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="48dp">

        <TextClock
            android:id="@+id/clock"
            style="@style/TextClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            tools:text="9:41" />

        <TextView
            android:id="@+id/date"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Thu, 30 Dec" />

        <!-- Search bar: a multi-line composer whose text goes to the default browser's
             search engine. The draft survives leaving the screen; only a successful send
             or the clear button empties it. -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/searchInput"
                style="@style/TextSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/search_the_web"
                android:imeOptions="flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingVertical="8dp"
                android:scrollbars="vertical" />

            <ImageView
                android:id="@+id/searchClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:padding="8dp"
                android:src="@drawable/ic_clear_text"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/searchGo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_the_web"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_forward"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Quick actions: round glyphs with a small label. -->
        <LinearLayout
            android:id="@+id/quickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/passwordManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="@string/password_manager"
                    android:padding="15dp"
                    android:src="@drawable/ic_key" />

                <TextView
                    android:id="@+id/passwordLabel"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="96dp"
                    tools:text="Bitwarden" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="56dp"
        android:text="@string/swipe_up_for_apps"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="56dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>
