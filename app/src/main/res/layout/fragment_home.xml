<?xml version="1.0" encoding="utf-8"?>
<app.olauncher.ui.SheetDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/home_screen"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.HomeFragment">

    <!-- Home and the app drawer are one surface. At rest only the date, the prompts and the
         search row show. Swiping up (or searching) lifts the sheet: the search row rides up to
         the top and the apps fill in below it, over this shade, while the home content fades.
         HomeFragment drives every view's position from a single open/closed progress. -->
    <View
        android:id="@+id/sheetScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="?attr/primaryShadeDarkColor"
        android:importantForAccessibility="no" />

    <!-- Date alone at the top; the middle of the screen is left for gestures. -->
    <TextView
        android:id="@+id/date"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/home_margin_horizontal"
        android:layout_marginTop="@dimen/home_date_margin_top"
        tools:text="Sun, 13 Sep" />

    <!-- Just above the resting search row (HomeFragment lifts it clear of the row as the row
         grows): the first-run tip card, then the set-default link. The card teaches one gesture
         at a time and retires once it has been used; tapping it performs the gesture for anyone
         who cannot or would rather not. -->
    <LinearLayout
        android:id="@+id/bottomPrompts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/home_margin_horizontal"
        android:animateLayoutChanges="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/coachCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_coach_card"
            android:clickable="true"
            android:focusable="true"
            android:clipToOutline="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/coachIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_swipe_up"
                app:tint="?attr/primaryColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/coachStep"
                    style="@style/TextTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    tools:text="Welcome · 1 of 2" />

                <TextView
                    android:id="@+id/coachTitle"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Swipe up for your apps" />

                <TextView
                    android:id="@+id/coachBody"
                    style="@style/TextTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    tools:text="Start anywhere on the empty screen. Or tap here." />
            </LinearLayout>

            <ImageView
                android:id="@+id/coachDismiss"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tips_skip"
                android:padding="13dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Set default launcher -->
        <TextView
            android:id="@+id/setDefaultLauncher"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/set_as_default_launcher_u"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The sheet: the search row on top, the apps below it. Clickable so a touch on its empty
         parts never falls through to the home gestures underneath. -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <!-- The search composer and the password-manager glyph, aligned to the composer's
             bottom edge so the glyph stays put while the composer grows. -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/home_margin_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="@dimen/search_row_margin_bottom"
            android:gravity="bottom"
            android:orientation="horizontal">

        <!-- Search composer for apps and the web: matching apps are listed above it, and enter
             sends the text to the chosen search engine. The draft survives leaving the screen;
             only a successful send or the clear button empties it. -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:alpha="0.8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/searchInput"
                style="@style/TextSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingVertical="10dp"
                android:scrollbars="vertical"
                tools:ignore="LabelFor" />

            <!-- Appears with the first character. The negative margins keep its 48dp touch target
                 inside the field's one-line height, so the bar keeps its size until the text
                 itself wraps onto another line. -->
            <ImageView
                android:id="@+id/searchClear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-2dp"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:padding="14dp"
                android:src="@drawable/ic_clear_text"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- The slot beside the composer: the password manager while the bar is empty, a filled
             send button while there is text. Same size as the composer so the row reads as one. -->
        <ImageView
            android:id="@+id/passwordManager"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_quick_action"
            android:clickable="true"
            android:contentDescription="@string/password_manager"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_key"
            app:tint="?attr/primaryColor" />

        <ImageView
            android:id="@+id/searchSend"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_send_action"
            android:clickable="true"
            android:contentDescription="@string/search_the_web"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_forward"
            android:visibility="gone"
            app:tint="?attr/primaryInverseColor"
            tools:visibility="visible" />
        </LinearLayout>

        <!-- First-run tip: gone for good once an app's long-press menu has been opened. -->
        <LinearLayout
            android:id="@+id/drawerTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/drawer_margin_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:ignore="UseCompoundDrawables">

            <TextView
                style="@style/TextTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tip_app_menu" />

            <ImageView
                android:id="@+id/drawerTipDismiss"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/got_it"
                android:padding="13dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Every app in its groups, or, while the bar holds text, the apps it matches, best
             first. Hidden while the sheet rests so TalkBack never wanders into it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/drawer_margin_horizontal"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:visibility="invisible" />
    </LinearLayout>

</app.olauncher.ui.SheetDragLayout>
