<?xml version="1.0" encoding="utf-8"?>
<!-- One row above the home search bar: an app the text matches. Indented to line up with the
     text in the bar below it. A work-profile or Private Space copy names its profile at the
     end, outside the label, so a long name is cut short before the profile ever is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/suggestionLabel"
        style="@style/TextMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Maps" />

    <TextView
        android:id="@+id/suggestionProfile"
        style="@style/TextTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:alpha="0.6"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="Work profile"
        tools:visibility="visible" />
</LinearLayout>
