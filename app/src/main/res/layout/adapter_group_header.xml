<?xml version="1.0" encoding="utf-8"?>
<!-- A category's row in the drawer: its glyph in the 48dp gutter the app glyphs use (20dp at
     24dp from the edge), so its name lines up with the app names it opens onto. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/groupTitle"
    style="@style/TextLarge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:drawablePadding="4dp"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:paddingHorizontal="24dp"
    android:paddingVertical="@dimen/app_padding_vertical"
    tools:drawableStart="@drawable/ic_category_ai"
    tools:text="AI Agents  6" />
