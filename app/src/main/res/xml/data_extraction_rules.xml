<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device: allowBackup="false" turns off cloud backup, and
  device-to-device transfer ignores that flag, so every domain is excluded here.
  An empty section would mean "back up everything", not nothing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
