<?xml version="1.0" encoding="utf-8"?>
<!-- The first-run tip card on the home screen; the same soft fill and hairline edge as the
     search bar so it reads as part of the bottom row, not as a system dialog. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/primaryShadeColor" />
    <corners android:radius="20dp" />
    <stroke
        android:width="0.5dp"
        android:color="?attr/primaryColorTrans50" />
</shape>
